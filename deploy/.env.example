# Copy to .env next to docker-compose.yml (or export in shell).
# Preserve an existing deploy/.env on recreate — do not overwrite it.
# Secret client key (Project settings → Client keys). Server ingest uses tal_sk_….
TALARIA_API_KEY=tal_sk_REPLACE_ME
# Optional ingest override. Leave unset so the key's cell selects
# https://ingest-<cell>.newtalaria.com (an nz1 key uses ingest-nz1).
# TALARIA_URL=https://ingest-nz1.newtalaria.com
TALARIA_RELEASE=argon2-demo
# Optional. Stamped on the release when set.
# TALARIA_COMMIT_SHA=
# Deep link shown under the buttons (org/project Performance).
TALARIA_DASHBOARD_URL=https://one.newtalaria.com
